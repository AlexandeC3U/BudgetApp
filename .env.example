# Copy to `.env` and fill in. Never commit the filled-in file — `.env` and
# `.env*.local` are both gitignored.
#
# NOTE ON PRECEDENCE: Next.js loads `.env.local` *after* `.env`, so a variable
# declared in `.env.local` wins — even when its value is empty. Don't redeclare
# a secret in both files; a blank entry in `.env.local` silently shadows the
# real value and the app fails at startup with "DATABASE_URL is not set".

# ─────── Postgres (Supabase) ───────
# Supabase → Project Settings → Database → Connection string.
# Local/dev: session pooler (port 5432) — drizzle-kit needs prepared statements.
# Vercel/serverless: prefer the transaction pooler (port 6543); the client
# already sets `prepare: false`, which that pooler requires.
# URL-encode special characters in the password: $ → %24, @ → %40, ^ → %5E.
DATABASE_URL=

# ─────── Clerk (Auth) ───────
# Clerk dashboard → API keys. Use the test keys for dev, live keys in prod.
# Both must come from the same Clerk instance or session refresh loops.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Use the in-app custom auth pages instead of Clerk's hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
